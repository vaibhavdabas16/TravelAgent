# Google Maps Platform API Key
# Get it from: https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Gemini API Key  
# Get it from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration
# Additional CORS origins for ngrok or custom domains (comma-separated)
# Example: ADDITIONAL_CORS_ORIGINS=https://abc123.ngrok-free.app,https://xyz789.ngrok-free.app
ADDITIONAL_CORS_ORIGINS=



# --- Maps provider -----------------------------------------------------------
# "google" uses GOOGLE_MAPS_API_KEY above (project must have billing enabled).
# "foursquare" uses Foursquare Places for POIs and Geoapify for geocoding and
# travel times; neither needs a card on file.
MAPS_PROVIDER=foursquare
# https://foursquare.com/developers/  -> Service key (Places API)
FOURSQUARE_API_KEY=
# https://myprojects.geoapify.com/    -> API key
GEOAPIFY_API_KEY=

# --- Redis cache -------------------------------------------------------------
# Local: leave these alone, the defaults point at localhost:6379. Caching is
# optional — the app runs without it, just slower and burning more API quota.
# Hosted (Render, Upstash, Railway): set REDIS_URL to the connection string
# they give you and it takes precedence over the host/port below. Use the
# rediss:// form for connections over the public internet.
# REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379

# --- AI ----------------------------------------------------------------------
# Pinecone powers semantic POI search. The index is created on first boot, so
# only the key is needed. https://app.pinecone.io -> API Keys
PINECONE_API_KEY=

# --- Travel inventory --------------------------------------------------------
# Amadeus (flights + hotels). https://developers.amadeus.com -> Self-Service app
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
# searchapi.io, used for flight lookups. https://www.searchapi.io
SEARCH_API_KEY=
# SerpAPI, used for price intelligence. https://serpapi.com
SERPAPI_API_KEY=

# --- Database ----------------------------------------------------------------
# The settings object builds the connection URL from these parts; there is no
# DATABASE_URL to set. docker compose overrides HOST/PORT to reach the
# postgres service, so these values are for running on the host directly.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=travel_agent
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# --- Security ----------------------------------------------------------------
# Generate a long random value. Leaving this unset falls back to a published
# placeholder, which would let anyone mint valid tokens.
JWT_SECRET_KEY=
